DATABASE_URL=postgresql+psycopg://tryon:tryon_local_only@127.0.0.1:5433/tryon
ASSET_ROOT=data/processed
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_UPLOAD_MB=12
ADMIN_TOKEN=
ONLINE_VTON_URL=
ONLINE_VTON_TOKEN=
ONLINE_VTON_STEPS=10
# Measured research preset; exact original pixels are retained outside the edit.
ONLINE_VTON_INPUT_ENCODING=jpeg95
ONLINE_VTON_TIMEOUT=600
# The API recovers the saved private Colab worker in the background at startup.
ONLINE_AUTO_CONNECT=true
# Local CPU body measurements and apparel charts. Private Colab still handles VTON.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=formfit_measurements
MEASUREMENT_MODEL_PATH=assets/pose/pose_landmarker_full.task
MEASUREMENT_OUTPUT_ROOT=data/processed/measurements
