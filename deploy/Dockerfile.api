FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend backend
COPY ml ml
COPY scripts scripts
COPY data/brandCharts data/brandCharts
COPY data/catalog data/catalog
COPY alembic.ini ./
RUN useradd --uid 10001 --create-home app && mkdir -p .runtime data/processed data/raw assets/pose && chown -R app:app /app
USER app
EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && exec uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 1 --no-proxy-headers"]
