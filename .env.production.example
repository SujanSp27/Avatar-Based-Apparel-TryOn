# Copy to .env.production, populate secrets locally; never commit that file.
ENVIRONMENT=production
PUBLIC_HOST=studio.example.com
APP_PUBLIC_URL=https://studio.example.com
CORS_ORIGINS=["https://studio.example.com"]
AUTH_SECRET=
AUTH_COOKIE_SECURE=true
AUTH_REQUIRE_VERIFICATION=true
ADMIN_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://vastra:REPLACE_URL_ENCODED_PASSWORD@db:5432/vastra
MONGO_ROOT_PASSWORD=
# Create a least-privilege readWrite user for this database before starting the API.
MONGODB_URI=mongodb://vastra_app:REPLACE_URL_ENCODED_PASSWORD@mongo:27017/vastra?authSource=vastra
MONGODB_DATABASE=vastra
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
ONLINE_AUTO_CONNECT=false
# Existing private Colab worker; its URL/token expire with the runtime.
ONLINE_VTON_URL=
ONLINE_VTON_TOKEN=
ONLINE_VTON_STEPS=10
ONLINE_VTON_TIMEOUT=600
PRIVATE_RETENTION_DAYS=30
GUEST_RETENTION_HOURS=24
